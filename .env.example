# Copy this file to ".env" (same folder) and fill in your own key.
# NEVER commit the real .env file to Git.

# Your DeepSeek API key (starts with "sk-...").
DEEPSEEK_API_KEY=

# Optional settings - the defaults below are correct for DeepSeek V4.1 Flash.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# Request timeout in seconds.
# DEEPSEEK_TIMEOUT=60

# "disabled" is faster and cheaper. Use "enabled" for harder reasoning.
# DEEPSEEK_THINKING=disabled

# Thinking effort: low | medium | high. Only used when thinking is enabled.
# low = fastest / shallowest, medium = balanced, high = deepest (slowest, priciest).
# DEEPSEEK_REASONING_EFFORT=medium

# Maximum output tokens for one AI answer.
# DEEPSEEK_MAX_TOKENS=2048

# Where the SQLite database is stored. Leave empty to use the default
# (project folder /data in development, %LOCALAPPDATA% when packaged).
# NUTRITION_APP_DATA_DIR=

# Set to 1 to write debug logs (your API key is never logged).
# NUTRITION_DEBUG=0

# Advanced / CI only: set to 1 to make these environment variables win over the
# values saved in the interface (model, base URL, thinking...). Off by default,
# because clicking "save" in the GUI should always have an effect.
# NUTRITION_ENV_WINS=0
